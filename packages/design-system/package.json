{
  "name": "@v/design-system",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./button": {
      "types": "./dist/components/button/index.d.mts",
      "import": "./dist/components/button/index.mjs"
    },
    "./combobox": {
      "types": "./dist/components/combobox/index.d.mts",
      "import": "./dist/components/combobox/index.mjs"
    },
    "./styles": "./dist/styles/index.css",
    "./tokens": "./dist/styles/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "reka-ui": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "unplugin-vue": "catalog:",
    "vite-plus": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
