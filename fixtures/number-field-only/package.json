{
  "name": "fixture-number-field-only",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build",
    "verify": "node ../../tools/scripts/src/assert-bundle.ts dist package.json"
  },
  "dependencies": {
    "@v/design-system": "workspace:*",
    "vue": "catalog:"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "bundle": {
    "present": [
      "VNumberField",
      "v-field"
    ],
    "absent": [
      "VCombobox",
      "ComboboxRoot",
      "DialogRoot",
      "TooltipRoot",
      "DropdownMenuRoot",
      "ToastRoot",
      "PopoverRoot"
    ],
    "maxGzip": {
      "js": 58000,
      "css": 2000
    }
  }
}
