{
  "name": "v-lib",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -F docs dev",
    "dev:playground": "vp run -F playground dev",
    "build": "vp run -r build",
    "verify": "vp run -r verify",
    "ready": "vp run -r build && vp check && vp run -r test && vp run -r verify",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
