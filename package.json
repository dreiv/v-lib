{
  "name": "v-lib",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -F docs dev",
    "dev:playground": "vp run -F playground dev",
    "build": "vp run -r build",
    "typecheck": "vp run -r typecheck",
    "tokens": "node tools/scripts/src/generate-tokens.ts",
    "icons:generate": "node tools/scripts/src/generate-icons.ts",
    "ready": "vp run -r build && vp check && vp run typecheck && vp run -r test",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
